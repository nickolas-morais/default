# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor: cron, gestão de usuários, remoção de arquivos e scripts (importação e teste de acesso)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do sistema (links de convite e de redefinição de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail de alertas
RESEND_API_KEY=
ALERTAS_FROM="YZI Jobs <alertas@seudominio.com.br>"

# A Vercel envia este valor no header Authorization das chamadas de cron
CRON_SECRET=
